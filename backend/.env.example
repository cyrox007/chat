DEBUG=True
FRONTEND_URL=http://localhost:5173

SERVER_HTTP_PROTOCOL=http://
SERVER_ADDR=localhost
SERVER_PORT=9000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat
DB_USER=postgres
DB_PASSWORD=postgres

# Redis is required in production for distributed realtime, presence and one-time socket tickets.
# Direct mode (default/backward-compatible):
REDIS_URL=redis://localhost:6379/0
# Sentinel mode: configure BOTH values below. When set, Sentinel takes precedence over REDIS_URL.
REDIS_SENTINEL_NODES=
REDIS_SENTINEL_MASTER=
REDIS_SENTINEL_MIN_OTHER_SENTINELS=0
# Optional Sentinel authentication:
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
# Optional Redis master authentication/db for Sentinel mode:
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REALTIME_TICKET_TTL_SECONDS=30
REALTIME_AUTH_TIMEOUT_SECONDS=8
REALTIME_PRESENCE_TTL_SECONDS=90
REALTIME_HEARTBEAT_SECONDS=25
REALTIME_SEND_TIMEOUT_SECONDS=5
REALTIME_OUTBOUND_QUEUE_SIZE=64
REALTIME_MESSAGE_RATE_LIMIT=25
REALTIME_MESSAGE_RATE_WINDOW_SECONDS=10
REALTIME_IDEMPOTENCY_TTL_SECONDS=600

# Unread Messenger email nudge. Delivery remains opt-in per Account preference.
MESSAGE_EMAIL_NUDGE_INACTIVITY_MINUTES=720
MESSAGE_EMAIL_NUDGE_COOLDOWN_MINUTES=1440
MESSAGE_EMAIL_DELIVERY_MAX_ATTEMPTS=5
MESSAGE_EMAIL_DELIVERY_RETRY_BASE_SECONDS=300
MESSAGE_EMAIL_DELIVERY_RETRY_MAX_SECONDS=21600
MESSAGE_EMAIL_DELIVERY_LEASE_SECONDS=300
MESSAGE_EMAIL_DELIVERY_BATCH_SIZE=50
MESSAGE_EMAIL_ONLINE_RECHECK_SECONDS=900

# SMTP transport. Keep HOST/FROM empty until email delivery is intentionally enabled.
MESSAGE_EMAIL_SMTP_HOST=
MESSAGE_EMAIL_SMTP_PORT=587
MESSAGE_EMAIL_SMTP_USERNAME=
MESSAGE_EMAIL_SMTP_PASSWORD=
MESSAGE_EMAIL_SMTP_STARTTLS=true
MESSAGE_EMAIL_SMTP_USE_SSL=false
MESSAGE_EMAIL_SMTP_TIMEOUT_SECONDS=10
MESSAGE_EMAIL_FROM_EMAIL=
MESSAGE_EMAIL_FROM_NAME=PubChat

# Web Push / VAPID. Generate one persistent key pair per environment and keep the private key secret.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_TTL_SECONDS=300
WEB_PUSH_DELIVERY_MAX_ATTEMPTS=5
WEB_PUSH_DELIVERY_RETRY_BASE_SECONDS=60
WEB_PUSH_DELIVERY_RETRY_MAX_SECONDS=1800
WEB_PUSH_DELIVERY_LEASE_SECONDS=180
WEB_PUSH_DELIVERY_BATCH_SIZE=50
WEB_PUSH_CONVERSATION_COOLDOWN_SECONDS=90

# Trust & Safety AI copilot. Disabled by default. The http_json provider points to
# an internal/provider adapter that accepts PubChat's structured assessment envelope.
# AI is advisory only: it cannot issue/revoke restrictions or decide appeals.
MODERATION_AI_PROVIDER=disabled
MODERATION_AI_ENDPOINT=
MODERATION_AI_API_KEY=
MODERATION_AI_MODEL=
MODERATION_AI_TIMEOUT_SECONDS=15
MODERATION_AI_MAX_TEXT_CHARS=4000
MODERATION_AI_MAX_ASSESSMENTS_PER_REPORT=3

# Privacy-minimal Trust & Safety behavioral signals. These generate advisory
# moderator evidence only; they never auto-issue restrictions.
ABUSE_DM_RECIPIENT_WINDOW_SECONDS=600
ABUSE_DM_DISTINCT_RECIPIENT_THRESHOLD=8
ABUSE_INVITE_WINDOW_SECONDS=600
ABUSE_INVITE_DISTINCT_RECIPIENT_THRESHOLD=12
ABUSE_RATE_LIMIT_DEDUPE_SECONDS=600

# Generate three different random values. Do not reuse these examples in production.
JWT_ACCESS_SECRET_KEY=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET_KEY=replace-with-at-least-32-random-characters-refresh
CSRF_SECRET_KEY=replace-with-at-least-32-random-characters-csrf
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CSRF_TOKEN_EXPIRE_MINUTES=30

MAX_FILE_SIZE=10485760
MAX_FILES_LIMIT=10
