[Unit]
Description=PubChat Backend
Requires=pubchat-backend.socket
After=network-online.target pubchat-backend.socket
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
Sockets=pubchat-backend.socket
WorkingDirectory=/home/projects/pubchat/backend
Environment=WEB_CONCURRENCY=2
Environment=UVICORN_FD=3
Environment=UVICORN_GRACEFUL_SHUTDOWN_SECONDS=30
ExecStart=/home/projects/pubchat/backend/venv/bin/python3 /home/projects/pubchat/backend/run_server.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=45
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
